# Discord webhook URL (for non-bot mode: Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Discord bot credentials (for --bot mode)
# Create an application at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=123456789012345678

# Target account (optional if using saved browser session)
TARGET_EMAIL=your.email@example.com
TARGET_PASSWORD=your_password

# NSTBrowser anti-detect browser (recommended for bypassing bot protection)
# Get your API key from NSTBrowser settings
# Get your Profile ID by right-clicking a profile in NSTBrowser -> Copy Profile ID
NSTBROWSER_API_KEY=your_nstbrowser_api_key
NSTBROWSER_PROFILE_ID=your_profile_id_here

# Optional: Direct CDP URL (alternative to SDK — for manual NSTBrowser connection)
# NSTBROWSER_CDP_URL=ws://127.0.0.1:8848/devtools/browser/...
